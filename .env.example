# Copy to .env (git-ignored) and fill in. Never commit real values.
AURORA_DB_PASSWORD=change-me-database-password
# Bootstrap administrator (admin@aurora.local). Leave empty to skip creating it.
AURORA_ADMIN_PASSWORD=
# Optional LLM provider. Leave AURORA_AI_PROVIDER=None to run without AI.
AURORA_AI_PROVIDER=None
AURORA_AI_ENDPOINT=
AURORA_AI_MODEL=
AURORA_AI_API_KEY=
