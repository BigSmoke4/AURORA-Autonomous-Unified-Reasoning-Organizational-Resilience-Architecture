@model Aurora.Web.Models.Modules.ContractsIndexViewModel
@{ ViewData["Title"] = "Contracts"; }

<section class="aurora-panel">
    <div class="aurora-panel-header"><h1>Contract terms</h1></div>
    <p class="aurora-note">A contract enters its renewal notice window when the remaining days fall to the notice period or below. Penalty exposure is the late-delivery penalty per day multiplied by the delay you enter below.</p>

    <form method="get" asp-controller="Contracts" asp-action="Index" class="aurora-inline-form">
        <label class="aurora-form__label">
            Delay to model (days)
            <input name="delayDays" type="number" min="0" max="365" value="@Model.DelayDays" class="aurora-form__input aurora-form__input--compact" />
        </label>
        <button type="submit" class="aurora-btn">Recalculate</button>
    </form>

    <div asp-validation-summary="All" class="aurora-form__errors"></div>

    <table class="aurora-table">
        <thead>
            <tr><th>Reference</th><th>Counterparty</th><th>Starts</th><th>Ends</th><th>Days remaining</th><th>State</th><th>Annual value</th><th>Penalty exposure</th></tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.Reference</td>
                <td>@row.Counterparty</td>
                <td>@ModuleFormatting.Date(row.StartsOnUtc)</td>
                <td>@ModuleFormatting.Date(row.EndsOnUtc)</td>
                <td>@row.DaysRemaining</td>
                <td><span class="aurora-status-pill aurora-status-pill--@row.Tone">@row.State</span></td>
                <td>@ModuleFormatting.Money(row.AnnualValue)</td>
                <td>@ModuleFormatting.Money(row.PenaltyExposure)</td>
            </tr>
        }
        @if (!Model.Rows.Any())
        {
            <tr><td colspan="8" class="aurora-table__empty">No contracts are registered yet.</td></tr>
        }
        </tbody>
    </table>
</section>

@if (User.HasClaim(Aurora.Modules.Identity.Domain.AuroraClaims.Permission, Aurora.Modules.Identity.Domain.AuroraPermissions.ContractsManage))
{
    <section class="aurora-panel aurora-panel--narrow">
        <h2>Register a contract</h2>
        <form asp-controller="Contracts" asp-action="Create" method="post" class="aurora-form">
            <div asp-validation-summary="ModelOnly" class="aurora-form__errors"></div>
            <label class="aurora-form__label">
                Reference
                <input asp-for="Form.Reference" class="aurora-form__input" />
                <span asp-validation-for="Form.Reference" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Counterparty
                <input asp-for="Form.Counterparty" class="aurora-form__input" />
                <span asp-validation-for="Form.Counterparty" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Starts on
                <input asp-for="Form.StartsOn" type="date" class="aurora-form__input" />
                <span asp-validation-for="Form.StartsOn" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Ends on
                <input asp-for="Form.EndsOn" type="date" class="aurora-form__input" />
                <span asp-validation-for="Form.EndsOn" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Annual value
                <input asp-for="Form.AnnualValue" type="number" step="0.01" min="0" class="aurora-form__input" />
                <span asp-validation-for="Form.AnnualValue" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Late penalty per day
                <input asp-for="Form.LatePenaltyPerDay" type="number" step="0.01" min="0" class="aurora-form__input" />
                <span asp-validation-for="Form.LatePenaltyPerDay" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Renewal notice period (days)
                <input asp-for="Form.NoticePeriodDays" type="number" min="0" max="365" class="aurora-form__input" />
                <span asp-validation-for="Form.NoticePeriodDays" class="aurora-form__errors"></span>
            </label>
            <button type="submit" class="aurora-btn aurora-btn--primary">Register contract</button>
        </form>
    </section>
}
