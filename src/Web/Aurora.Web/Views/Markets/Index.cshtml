@model Aurora.Web.Models.Modules.MarketsIndexViewModel
@{ ViewData["Title"] = "Markets"; }

<section class="aurora-panel">
    <div class="aurora-panel-header"><h1>Market trends</h1></div>
    <p class="aurora-note">Change is the latest observation relative to the one before it. A move of 2% or less in either direction is reported as stable. Indices may use any consistent base, so only relative change is meaningful.</p>

    <table class="aurora-table">
        <thead>
            <tr><th>Market</th><th>Observations</th><th>Latest</th><th>Demand change</th><th>Price change</th><th>Demand direction</th></tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.Market</td>
                <td>@row.Observations</td>
                <td>@ModuleFormatting.Date(row.LatestOnUtc)</td>
                <td>@ModuleFormatting.Percent(row.DemandChangePct)</td>
                <td>@ModuleFormatting.Percent(row.PriceChangePct)</td>
                <td>@row.Direction</td>
            </tr>
        }
        @if (!Model.Rows.Any())
        {
            <tr><td colspan="6" class="aurora-table__empty">No market observations are recorded yet.</td></tr>
        }
        </tbody>
    </table>
</section>

@if (User.HasClaim(Aurora.Modules.Identity.Domain.AuroraClaims.Permission, Aurora.Modules.Identity.Domain.AuroraPermissions.MarketsManage))
{
    <section class="aurora-panel aurora-panel--narrow">
        <h2>Record an observation</h2>
        <form asp-controller="Markets" asp-action="Create" method="post" class="aurora-form">
            <div asp-validation-summary="ModelOnly" class="aurora-form__errors"></div>
            <label class="aurora-form__label">
                Market
                <input asp-for="Form.Market" class="aurora-form__input" />
                <span asp-validation-for="Form.Market" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Observed on
                <input asp-for="Form.ObservedOn" class="aurora-form__input" />
                <span asp-validation-for="Form.ObservedOn" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Demand index
                <input asp-for="Form.DemandIndex" type="number" step="0.0001" min="0.0001" class="aurora-form__input" />
                <span asp-validation-for="Form.DemandIndex" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Price index
                <input asp-for="Form.PriceIndex" type="number" step="0.0001" min="0.0001" class="aurora-form__input" />
                <span asp-validation-for="Form.PriceIndex" class="aurora-form__errors"></span>
            </label>
            <button type="submit" class="aurora-btn aurora-btn--primary">Save observation</button>
        </form>
    </section>
}
