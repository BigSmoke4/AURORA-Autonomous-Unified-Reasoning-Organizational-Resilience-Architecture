@model Aurora.Web.Models.Modules.WorkforceIndexViewModel
@{ ViewData["Title"] = "Workforce"; }

<section class="aurora-panel">
    <div class="aurora-panel-header"><h1>Workforce coverage</h1></div>
    <p class="aurora-note">Headcount for each critical role, counted from the digital-twin employee roster by exact role title. Coverage below the required headcount, or a role held by one person, is flagged.</p>

    <table class="aurora-table">
        <thead>
            <tr><th>Role</th><th>Role title</th><th>Criticality</th><th>Required</th><th>Actual</th><th>Coverage</th><th>Status</th></tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.Name</td>
                <td>@row.RoleTitle</td>
                <td>@row.Criticality</td>
                <td>@row.RequiredHeadcount</td>
                <td>@row.ActualHeadcount</td>
                <td>@ModuleFormatting.Percent(row.CoveragePct)</td>
                <td><span class="aurora-status-pill aurora-status-pill--@row.Tone">@row.Status</span></td>
            </tr>
        }
        @if (!Model.Rows.Any())
        {
            <tr><td colspan="7" class="aurora-table__empty">No critical roles are defined yet.</td></tr>
        }
        </tbody>
    </table>
</section>

@if (User.HasClaim(Aurora.Modules.Identity.Domain.AuroraClaims.Permission, Aurora.Modules.Identity.Domain.AuroraPermissions.WorkforceManage))
{
    <section class="aurora-panel aurora-panel--narrow">
        <h2>Add a critical role</h2>
        <form asp-controller="Workforce" asp-action="Create" method="post" class="aurora-form">
            <div asp-validation-summary="ModelOnly" class="aurora-form__errors"></div>
            <label class="aurora-form__label">
                Role name
                <input asp-for="Form.Name" class="aurora-form__input" />
                <span asp-validation-for="Form.Name" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Role title (must match the employee roster exactly)
                <input asp-for="Form.RoleTitle" list="known-role-titles" class="aurora-form__input" />
                <span asp-validation-for="Form.RoleTitle" class="aurora-form__errors"></span>
            </label>
            <datalist id="known-role-titles">
                @foreach (var title in Model.KnownRoleTitles)
                {
                    <option value="@title"></option>
                }
            </datalist>
            <label class="aurora-form__label">
                Required headcount
                <input asp-for="Form.RequiredHeadcount" type="number" min="1" max="10000" class="aurora-form__input" />
                <span asp-validation-for="Form.RequiredHeadcount" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Criticality (1 low to 5 high)
                <input asp-for="Form.Criticality" type="number" min="1" max="5" class="aurora-form__input" />
                <span asp-validation-for="Form.Criticality" class="aurora-form__errors"></span>
            </label>
            <button type="submit" class="aurora-btn aurora-btn--primary">Add role</button>
        </form>
    </section>
}
