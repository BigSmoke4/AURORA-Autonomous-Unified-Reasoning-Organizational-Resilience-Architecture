@using Aurora.Modules.Identity.Domain
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &mdash; AURORA</title>
    <link rel="stylesheet" href="~/css/aurora.css" asp-append-version="true" />
</head>
<body>
    <div class="aurora-shell">
        <header class="aurora-topbar">
            <div class="aurora-topbar__brand">
                <span class="aurora-topbar__logo">AURORA</span>
                <span class="aurora-topbar__tagline">Autonomous Unified Reasoning &amp; Organizational Resilience Architecture</span>
            </div>
            <nav class="aurora-topbar__nav">
                <a asp-controller="CommandCenter" asp-action="Index">Command Center</a>
                <a asp-controller="DigitalTwin" asp-action="Index">Digital Twin</a>
                <a asp-controller="Scenarios" asp-action="Index">Scenario Lab</a>
                <a asp-controller="Strategy" asp-action="Index">Strategy Lab</a>
                <a asp-controller="Forecasting" asp-action="Index">Forecasting</a>
                <a asp-controller="Decisions" asp-action="Index">Decisions</a>
                @{
                    var canSeeEnterprise = User.HasClaim(AuroraClaims.Permission, AuroraPermissions.WorkforceRead)
                        || User.HasClaim(AuroraClaims.Permission, AuroraPermissions.FinanceRead)
                        || User.HasClaim(AuroraClaims.Permission, AuroraPermissions.OperationsRead)
                        || User.HasClaim(AuroraClaims.Permission, AuroraPermissions.TechnologyRead)
                        || User.HasClaim(AuroraClaims.Permission, AuroraPermissions.SupplyChainRead)
                        || User.HasClaim(AuroraClaims.Permission, AuroraPermissions.AssetsRead)
                        || User.HasClaim(AuroraClaims.Permission, AuroraPermissions.ContractsRead)
                        || User.HasClaim(AuroraClaims.Permission, AuroraPermissions.MarketsRead);
                    var canSeeInsight = User.HasClaim(AuroraClaims.Permission, AuroraPermissions.CustomersRead)
                        || User.HasClaim(AuroraClaims.Permission, AuroraPermissions.MonitoringRead)
                        || User.HasClaim(AuroraClaims.Permission, AuroraPermissions.AlertsRead)
                        || User.HasClaim(AuroraClaims.Permission, AuroraPermissions.ReportsRead);
                }
                @if (canSeeEnterprise)
                {
                    <details class="aurora-nav-group">
                        <summary>Enterprise</summary>
                        <div class="aurora-nav-group__menu">
                            @if (User.HasClaim(AuroraClaims.Permission, AuroraPermissions.WorkforceRead)) { <a asp-controller="Workforce" asp-action="Index">Workforce</a> }
                            @if (User.HasClaim(AuroraClaims.Permission, AuroraPermissions.FinanceRead)) { <a asp-controller="Finance" asp-action="Index">Finance</a> }
                            @if (User.HasClaim(AuroraClaims.Permission, AuroraPermissions.OperationsRead)) { <a asp-controller="Operations" asp-action="Index">Operations</a> }
                            @if (User.HasClaim(AuroraClaims.Permission, AuroraPermissions.TechnologyRead)) { <a asp-controller="Technology" asp-action="Index">Technology</a> }
                            @if (User.HasClaim(AuroraClaims.Permission, AuroraPermissions.SupplyChainRead)) { <a asp-controller="SupplyChain" asp-action="Index">Supply Chain</a> }
                            @if (User.HasClaim(AuroraClaims.Permission, AuroraPermissions.AssetsRead)) { <a asp-controller="Assets" asp-action="Index">Assets</a> }
                            @if (User.HasClaim(AuroraClaims.Permission, AuroraPermissions.ContractsRead)) { <a asp-controller="Contracts" asp-action="Index">Contracts</a> }
                            @if (User.HasClaim(AuroraClaims.Permission, AuroraPermissions.MarketsRead)) { <a asp-controller="Markets" asp-action="Index">Markets</a> }
                        </div>
                    </details>
                }
                @if (canSeeInsight)
                {
                    <details class="aurora-nav-group">
                        <summary>Insight</summary>
                        <div class="aurora-nav-group__menu">
                            @if (User.HasClaim(AuroraClaims.Permission, AuroraPermissions.CustomersRead)) { <a asp-controller="Customers" asp-action="Index">Customers</a> }
                            @if (User.HasClaim(AuroraClaims.Permission, AuroraPermissions.MonitoringRead)) { <a asp-controller="Monitoring" asp-action="Index">Monitoring</a> }
                            @if (User.HasClaim(AuroraClaims.Permission, AuroraPermissions.AlertsRead)) { <a asp-controller="Alerts" asp-action="Index">Alerts</a> }
                            @if (User.HasClaim(AuroraClaims.Permission, AuroraPermissions.KnowledgeRead)) { <a asp-controller="Knowledge" asp-action="Index">Knowledge</a> }
                            @if (User.HasClaim(AuroraClaims.Permission, AuroraPermissions.ReportsRead)) { <a asp-controller="Reporting" asp-action="Index">Executive report</a> }
                        </div>
                    </details>
                }
                @if (User.HasClaim(AuroraClaims.Permission, AuroraPermissions.AuditRead))
                {
                    <a asp-controller="Audit" asp-action="Index">Audit</a>
                }
            </nav>
            <div class="aurora-topbar__user">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="aurora-topbar__username">@User.Identity!.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="aurora-inline-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="aurora-btn aurora-btn--ghost">Sign out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="aurora-btn aurora-btn--ghost">Sign in</a>
                }
            </div>
        </header>

        <main class="aurora-main">
            <partial name="_FlashMessages" />
            @RenderBody()
        </main>

        <footer class="aurora-footer">
            <span>AURORA &mdash; Enterprise Digital Twin &amp; Decision Intelligence Platform</span>
        </footer>
    </div>

    <script src="~/js/aurora.core.js" asp-append-version="true"></script>
    <script src="~/js/aurora.api.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
