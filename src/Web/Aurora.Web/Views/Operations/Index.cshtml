@model Aurora.Web.Models.Modules.OperationsIndexViewModel
@{ ViewData["Title"] = "Operations"; }

<section class="aurora-panel">
    <div class="aurora-panel-header"><h1>Plan attainment and yield</h1></div>
    <p class="aurora-note">Attainment is actual output over planned output, with a 95% target. First-pass yield is the share of output that was not defective, with a 98% target. The table shows the 200 most recent periods.</p>

    <table class="aurora-table">
        <thead>
            <tr><th>Factory</th><th>Period start</th><th>Planned</th><th>Actual</th><th>Defective</th><th>Attainment</th><th>First-pass yield</th><th>Plan status</th><th>Quality status</th></tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.Factory</td>
                <td>@ModuleFormatting.Date(row.PeriodStartUtc)</td>
                <td>@row.PlannedUnits</td>
                <td>@row.ActualUnits</td>
                <td>@row.DefectiveUnits</td>
                <td>@ModuleFormatting.Percent(row.AttainmentPct)</td>
                <td>@ModuleFormatting.Percent(row.FirstPassYieldPct)</td>
                <td>@row.AttainmentStatus</td>
                <td><span class="aurora-status-pill aurora-status-pill--@row.Tone">@row.YieldStatus</span></td>
            </tr>
        }
        @if (!Model.Rows.Any())
        {
            <tr><td colspan="9" class="aurora-table__empty">No production records yet.</td></tr>
        }
        </tbody>
    </table>
</section>

@if (User.HasClaim(Aurora.Modules.Identity.Domain.AuroraClaims.Permission, Aurora.Modules.Identity.Domain.AuroraPermissions.OperationsManage))
{
    <section class="aurora-panel aurora-panel--narrow">
        <h2>Record production</h2>
        <form asp-controller="Operations" asp-action="Create" method="post" class="aurora-form">
            <div asp-validation-summary="ModelOnly" class="aurora-form__errors"></div>
            <label class="aurora-form__label">
                Factory
                <select asp-for="Form.FactoryId" asp-items="Model.Factories" class="aurora-form__input">
                    <option value="">Select a factory</option>
                </select>
                <span asp-validation-for="Form.FactoryId" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Period start
                <input asp-for="Form.PeriodStart" class="aurora-form__input" />
                <span asp-validation-for="Form.PeriodStart" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Planned units
                <input asp-for="Form.PlannedUnits" type="number" min="1" class="aurora-form__input" />
                <span asp-validation-for="Form.PlannedUnits" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Actual units
                <input asp-for="Form.ActualUnits" type="number" min="0" class="aurora-form__input" />
                <span asp-validation-for="Form.ActualUnits" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Defective units
                <input asp-for="Form.DefectiveUnits" type="number" min="0" class="aurora-form__input" />
                <span asp-validation-for="Form.DefectiveUnits" class="aurora-form__errors"></span>
            </label>
            <button type="submit" class="aurora-btn aurora-btn--primary">Save record</button>
        </form>
    </section>
}
