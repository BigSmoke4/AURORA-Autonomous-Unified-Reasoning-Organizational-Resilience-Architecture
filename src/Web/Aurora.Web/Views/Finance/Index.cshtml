@model Aurora.Web.Models.Modules.FinanceIndexViewModel
@{ ViewData["Title"] = "Finance"; }

<section class="aurora-panel">
    <div class="aurora-panel-header"><h1>Budget position</h1></div>
    <p class="aurora-note">Variance is budget minus spend, so a negative value means overspend. Utilization at or above 90% of budget is flagged as near the limit. Totals are decimal money, rounded to two places.</p>
    <div class="aurora-metrics-strip">
        <div class="aurora-metric"><span class="aurora-metric__label">Total budget</span><span class="aurora-metric__value">@ModuleFormatting.Money(Model.TotalBudget)</span></div>
        <div class="aurora-metric"><span class="aurora-metric__label">Total spend</span><span class="aurora-metric__value">@ModuleFormatting.Money(Model.TotalSpend)</span></div>
    </div>

    <table class="aurora-table">
        <thead>
            <tr><th>Code</th><th>Cost center</th><th>Budget</th><th>Spend</th><th>Variance</th><th>Utilization</th><th>Status</th></tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.Code</td>
                <td>@row.Name</td>
                <td>@ModuleFormatting.Money(row.Budget)</td>
                <td>@ModuleFormatting.Money(row.Spend)</td>
                <td>@ModuleFormatting.Money(row.Variance)</td>
                <td>@ModuleFormatting.Percent(row.UtilizationPct)</td>
                <td><span class="aurora-status-pill aurora-status-pill--@row.Tone">@row.Status</span></td>
            </tr>
        }
        @if (!Model.Rows.Any())
        {
            <tr><td colspan="7" class="aurora-table__empty">No cost centers are defined yet.</td></tr>
        }
        </tbody>
    </table>
</section>

@if (User.HasClaim(Aurora.Modules.Identity.Domain.AuroraClaims.Permission, Aurora.Modules.Identity.Domain.AuroraPermissions.FinanceManage))
{
    <section class="aurora-panel aurora-panel--narrow">
        <h2>Add a cost center</h2>
        <form asp-controller="Finance" asp-action="Create" method="post" class="aurora-form">
            <div asp-validation-summary="ModelOnly" class="aurora-form__errors"></div>
            <label class="aurora-form__label">
                Code
                <input asp-for="Form.Code" class="aurora-form__input" />
                <span asp-validation-for="Form.Code" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Name
                <input asp-for="Form.Name" class="aurora-form__input" />
                <span asp-validation-for="Form.Name" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Annual budget
                <input asp-for="Form.AnnualBudget" type="number" step="0.01" min="0" class="aurora-form__input" />
                <span asp-validation-for="Form.AnnualBudget" class="aurora-form__errors"></span>
            </label>
            <label class="aurora-form__label">
                Actual spend to date
                <input asp-for="Form.ActualSpend" type="number" step="0.01" min="0" class="aurora-form__input" />
                <span asp-validation-for="Form.ActualSpend" class="aurora-form__errors"></span>
            </label>
            <button type="submit" class="aurora-btn aurora-btn--primary">Add cost center</button>
        </form>
    </section>
}
