<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aurora.Web</RootNamespace>
    <UserSecretsId>aurora-web-secrets</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.19.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Aurora.Shared\Aurora.Shared.csproj" />
    <ProjectReference Include="..\..\Modules\Aurora.Modules.Identity\Aurora.Modules.Identity.csproj" />
    <ProjectReference Include="..\..\Modules\Aurora.Modules.Organizations\Aurora.Modules.Organizations.csproj" />
    <ProjectReference Include="..\..\Modules\Aurora.Modules.DigitalTwin\Aurora.Modules.DigitalTwin.csproj" />
    <ProjectReference Include="..\..\Modules\Aurora.Modules.Graph\Aurora.Modules.Graph.csproj" />
    <ProjectReference Include="..\..\Modules\Aurora.Modules.Scenarios\Aurora.Modules.Scenarios.csproj" />
    <ProjectReference Include="..\..\Modules\Aurora.Modules.Simulation\Aurora.Modules.Simulation.csproj" />
    <ProjectReference Include="..\..\Modules\Aurora.Modules.Risk\Aurora.Modules.Risk.csproj" />
    <ProjectReference Include="..\..\Modules\Aurora.Modules.Decisions\Aurora.Modules.Decisions.csproj" />
    <ProjectReference Include="..\..\Modules\Aurora.Modules.AI\Aurora.Modules.AI.csproj" />
  </ItemGroup>
</Project>
