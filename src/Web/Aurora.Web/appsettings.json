{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "AuroraDb": "Host=localhost;Port=5432;Database=aurora;Username=aurora;Password=1234"
  },
  "AI": {
    "Provider": "None",
    "Comment": "Set Provider to a real value (e.g. 'OpenAI' or 'Anthropic') and configure ApiKey via user-secrets or environment variables once a real IAiProvider implementation is registered in Program.cs. Until then AURORA runs on NullAiProvider and all evidence/graph/simulation features remain fully functional (spec section 71)."
  },
  "Risk": {
    "ScoringWeights": {
      "ProbabilityWeight": 1.0,
      "ImpactWeight": 1.0,
      "ExposureWeight": 1.0,
      "CriticalityWeight": 1.0
    }
  },
  "Decisions": {
    "ScoringWeights": {
      "FinancialBenefitWeight": 0.30,
      "RiskReductionWeight": 0.25,
      "OperationalFeasibilityWeight": 0.20,
      "StrategicAlignmentWeight": 0.15,
      "TimeToBenefitWeight": 0.10
    }
  },
  "AllowedHosts": "*"
}
