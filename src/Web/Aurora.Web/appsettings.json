      "FinancialBenefitWeight": 0.30,
      "RiskReductionWeight": 0.25,
      "OperationalFeasibilityWeight": 0.20,
      "StrategicAlignmentWeight": 0.15,
      "TimeToBenefitWeight": 0.10
    }
  },
  "AllowedHosts": "*"
