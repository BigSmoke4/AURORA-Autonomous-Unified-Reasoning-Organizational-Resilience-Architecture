{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "AuroraDb": ""
  },
  "Seed": {
    "AdminPassword": ""
  },
  "AI": {
    "Provider": "None",
    "Endpoint": "",
    "Model": "",
    "ApiKey": "",
    "TimeoutSeconds": 20,
    "Comment": "Provider: None | OpenAICompatible. The API key must come from user-secrets or theenvironment variable, never from this file."
  },
  "Risk": {
    "ScoringWeights": {
      "ProbabilityWeight": 1.0,
      "ImpactWeight": 1.0,
      "ExposureWeight": 1.0,
